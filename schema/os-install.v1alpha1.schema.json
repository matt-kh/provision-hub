{
  "$defs": {
    "interface": {
      "additionalProperties": false,
      "properties": {
        "addresses": {
          "default": [],
          "description": "Static addresses in CIDR form (IPv4 or IPv6).",
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "dhcp4": {
          "default": false,
          "type": "boolean"
        },
        "dhcp6": {
          "default": false,
          "type": "boolean"
        },
        "gateway4": {
          "description": "IPv4 default gateway.",
          "type": "string"
        },
        "gateway6": {
          "description": "IPv6 default gateway.",
          "type": "string"
        },
        "macaddress": {
          "description": "Match the NIC by MAC address.",
          "pattern": "^([0-9a-f]{2}:){5}[0-9a-f]{2}$",
          "type": "string"
        },
        "mtu": {
          "maximum": 9216,
          "minimum": 576,
          "type": "integer"
        },
        "name": {
          "description": "Interface name after install (renamed via macaddress when given).",
          "pattern": "^[A-Za-z0-9._-]{1,15}$",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "user": {
      "additionalProperties": false,
      "properties": {
        "gecos": {
          "description": "Full name / comment field.",
          "type": "string"
        },
        "groups": {
          "default": [],
          "description": "Supplementary groups.",
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "name": {
          "description": "Login name.",
          "pattern": "^[a-z_][a-z0-9_-]{0,31}$",
          "type": "string"
        },
        "password_hash": {
          "description": "Optional crypt(3) hash (yescrypt, SHA-512 or SHA-256). Plain passwords are never accepted.",
          "pattern": "^\\$(y|gy|6|5)\\$[./0-9A-Za-z$=,]+$",
          "type": "string"
        },
        "shell": {
          "default": "/bin/bash",
          "description": "Login shell.",
          "pattern": "^/",
          "type": "string"
        },
        "ssh_authorized_keys": {
          "default": [],
          "description": "OpenSSH public keys (identity is ssh-key based by default).",
          "items": {
            "pattern": "^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)|sk-ssh-ed25519@openssh.com|sk-ecdsa-sha2-nistp256@openssh.com) [A-Za-z0-9+/=]+( .*)?$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "sudo": {
          "default": false,
          "description": "Passwordless sudo for this user.",
          "type": "boolean"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/matt-kh/provision-hub/main/schema/os-install.v1alpha1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "backend": {
            "const": "nixos-disko"
          }
        },
        "required": [
          "backend"
        ]
      },
      "then": {
        "required": [
          "nixos-disko"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "backend": {
            "const": "ubuntu-autoinstall"
          }
        },
        "required": [
          "backend"
        ]
      },
      "then": {
        "required": [
          "ubuntu-autoinstall"
        ]
      }
    }
  ],
  "description": "One machine's operating-system install: host identity, users, network and whole disks.",
  "properties": {
    "api_version": {
      "const": "prov/v1alpha1",
      "description": "Spec format version; required."
    },
    "arch": {
      "default": "amd64",
      "enum": [
        "amd64",
        "arm64"
      ]
    },
    "backend": {
      "description": "Backend that renders this spec; names the backend table.",
      "enum": [
        "nixos-disko",
        "ubuntu-autoinstall"
      ],
      "type": "string"
    },
    "domain": {
      "description": "DNS domain; the FQDN is hostname.domain.",
      "pattern": "^([a-z0-9]([a-z0-9-]*[a-z0-9])?\\.)+[a-z]{2,}$",
      "type": "string"
    },
    "firmware": {
      "default": "uefi",
      "enum": [
        "uefi",
        "bios"
      ]
    },
    "hostname": {
      "description": "Short host name (one DNS label).",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
      "type": "string"
    },
    "keyboard": {
      "default": "us",
      "description": "Console keyboard layout.",
      "pattern": "^[a-z0-9_-]+$",
      "type": "string"
    },
    "kind": {
      "const": "os-install",
      "description": "Kind of item; equals the directory <root>/<kind>/."
    },
    "locale": {
      "default": "en_US.UTF-8",
      "description": "POSIX locale.",
      "pattern": "^[A-Za-z0-9_.@-]+$",
      "type": "string"
    },
    "network": {
      "additionalProperties": false,
      "properties": {
        "dns": {
          "additionalProperties": false,
          "default": {},
          "properties": {
            "nameservers": {
              "default": [],
              "description": "DNS servers (IP addresses).",
              "items": {
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
            },
            "search": {
              "default": [],
              "description": "DNS search domains.",
              "items": {
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
            }
          },
          "type": "object"
        },
        "interfaces": {
          "items": {
            "$ref": "#/$defs/interface"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "interfaces"
      ],
      "type": "object"
    },
    "nixos-disko": {
      "additionalProperties": false,
      "description": "NixOS (flake + disko) settings.",
      "properties": {
        "cpu_vendor": {
          "description": "Enables the CPU microcode updates of this vendor.",
          "enum": [
            "intel",
            "amd"
          ]
        },
        "esp_size": {
          "default": "512M",
          "description": "Size of the EFI system partition mounted at /boot (UEFI only, at least 256M; leave the default on BIOS).",
          "pattern": "^[1-9][0-9]*[MG]$",
          "type": "string"
        },
        "hibernate": {
          "default": false,
          "description": "Resume from hibernation on the swap device (boot.resumeDevice); needs swap_size, at least the RAM size.",
          "type": "boolean"
        },
        "layout": {
          "default": "ext4",
          "description": "Disk layout. ext4: GPT on one disk with an ESP (UEFI) or BIOS boot partition, optional swap and an ext4 root. ext4-luks (UEFI only): an ESP and one LUKS2 partition holding LVM volume group 'pool' with optional swap, an ext4 root and the ext4 volumes; the passphrase is typed at install time and at every boot.",
          "enum": [
            "ext4",
            "ext4-luks"
          ]
        },
        "packages": {
          "default": [],
          "description": "nixpkgs attribute names added to environment.systemPackages (e.g. git, python3Packages.requests).",
          "items": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_-]*(\\.[A-Za-z_][A-Za-z0-9_-]*)*$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "release": {
          "description": "nixpkgs stable branch the flake follows, e.g. nixos-26.05.",
          "pattern": "^nixos-[0-9]{2}\\.[0-9]{2}$",
          "type": "string"
        },
        "root_size": {
          "default": "100%FREE",
          "description": "ext4-luks: size of the root logical volume (at least 8G), or 100%FREE for the space left. Exactly one of root and volumes takes 100%FREE.",
          "pattern": "^([1-9][0-9]*[MG]|100%FREE)$",
          "type": "string"
        },
        "state_version": {
          "description": "system.stateVersion: the release first installed; never change it afterwards.",
          "pattern": "^[0-9]{2}\\.[0-9]{2}$",
          "type": "string"
        },
        "swap_size": {
          "description": "Optional swap size (e.g. 8G): a partition (ext4) or a logical volume (ext4-luks); no swap when absent.",
          "pattern": "^[1-9][0-9]*[MG]$",
          "type": "string"
        },
        "volumes": {
          "default": [],
          "description": "ext4-luks: extra ext4 logical volumes in volume group 'pool', each mounted at its mountpoint.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "mount_options": {
                "default": [],
                "description": "ext4 mount options, one per item (e.g. noatime, nodev, nosuid, noexec).",
                "items": {
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.=:+-]*$",
                  "type": "string"
                },
                "type": "array",
                "uniqueItems": true
              },
              "mountpoint": {
                "description": "Absolute, normalised, unique mount point; not /, nor /boot, /nix, /proc, /sys, /dev, /run or anything below them.",
                "maxLength": 255,
                "pattern": "^/[A-Za-z0-9._/-]*$",
                "type": "string"
              },
              "name": {
                "description": "Logical volume name: unique, not root or swap, not starting with snapshot or pvmove.",
                "maxLength": 32,
                "pattern": "^[a-z][a-z0-9-]*$",
                "type": "string"
              },
              "owner": {
                "description": "A [[users]] name: the mount point becomes owned by this user (group users, mode 0750) via systemd-tmpfiles. Not on /home, /tmp, /srv, /opt, /mnt, /media themselves or at/below /var, /etc, /usr.",
                "pattern": "^[a-z_][a-z0-9_-]{0,31}$",
                "type": "string"
              },
              "size": {
                "description": "Size (e.g. 200G) or 100%FREE for the space left.",
                "pattern": "^([1-9][0-9]*[MG]|100%FREE)$",
                "type": "string"
              }
            },
            "required": [
              "name",
              "mountpoint",
              "size"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "release",
        "state_version"
      ],
      "type": "object"
    },
    "storage": {
      "additionalProperties": false,
      "properties": {
        "disks": {
          "description": "Whole disks the installer may claim and wipe, in order (first = boot disk).",
          "items": {
            "pattern": "^/dev/[A-Za-z0-9._:+/-]+$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "disks"
      ],
      "type": "object"
    },
    "timezone": {
      "default": "Etc/UTC",
      "description": "IANA time zone.",
      "pattern": "^[A-Za-z0-9_+/-]+$",
      "type": "string"
    },
    "ubuntu-autoinstall": {
      "additionalProperties": false,
      "description": "Ubuntu Server autoinstall settings.",
      "properties": {
        "packages": {
          "default": [],
          "description": "Extra packages installed by autoinstall.",
          "items": {
            "pattern": "^[a-z0-9][a-z0-9+.-]+$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "release": {
          "description": "LTS release of the live-server ISO.",
          "enum": [
            "22.04",
            "24.04"
          ]
        },
        "storage": {
          "additionalProperties": false,
          "properties": {
            "layout": {
              "description": "lvm: one VG over all disks; zfs: root pool on one disk; mdraid: md array over all disks.",
              "enum": [
                "lvm",
                "zfs",
                "mdraid"
              ]
            },
            "raid_level": {
              "description": "mdraid only; default 1.",
              "enum": [
                1,
                5,
                6,
                10
              ]
            }
          },
          "required": [
            "layout"
          ],
          "type": "object"
        },
        "updates": {
          "default": "security",
          "enum": [
            "security",
            "all"
          ]
        }
      },
      "required": [
        "release",
        "storage"
      ],
      "type": "object"
    },
    "users": {
      "default": [],
      "description": "Local users; backends without local users ignore or reject them.",
      "items": {
        "$ref": "#/$defs/user"
      },
      "type": "array"
    }
  },
  "required": [
    "api_version",
    "kind",
    "backend",
    "hostname",
    "network",
    "storage"
  ],
  "title": "prov os-install v1alpha1",
  "type": "object"
}
